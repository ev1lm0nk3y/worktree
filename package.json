{
  "name": "@agenttools/worktree",
  "version": "1.1.2",
  "description": "CLI tool for managing Git worktrees with GitHub issues and Claude Code integration",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "worktree": "./dist/index.js",
    "wt": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "setup": "npm install && npm run build && npm link",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "git",
    "worktree",
    "github",
    "tmux",
    "claude",
    "cli"
  ],
  "author": "agenttools",
  "license": "MIT",
  "dependencies": {
    "@linear/sdk": "^24.0.0",
    "chalk": "^5.6.2",
    "commander": "^11.1.0",
    "js-yaml": "^4.1.1",
    "minimatch": "^10.2.5",
    "ora": "^7.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^10.2.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
